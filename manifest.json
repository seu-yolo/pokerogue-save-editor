{
  "manifest_version": 3,
  "name": "洛托姆口袋 · RogueSave",
  "short_name": "洛托姆口袋",
  "version": "0.4.4",
  "minimum_chrome_version": "116",
  "description": "管理 PokéRogue 当前对局、永久宝可梦收藏、抽奖券与随机传说蛋。",
  "permissions": [
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://pokerogue.net/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开洛托姆口袋"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
